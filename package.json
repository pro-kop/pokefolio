{
  "name": "pokefolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Osobní portfolio Pokémon TCG sbírky s denním sledováním cen z Cardmarketu.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "adduser": "node scripts/add-user.mjs",
    "fetch:catalog": "node scripts/fetch-catalog.mjs",
    "fetch:prices": "node scripts/fetch-prices.mjs",
    "radar": "node scripts/compute-radar.mjs",
    "etl": "npm run fetch:prices && npm run radar"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
